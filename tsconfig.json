  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts", "oxlint.config.ts", "oxfmt.config.ts"],
  "exclude": ["node_modules", "docs", "test"]
}
