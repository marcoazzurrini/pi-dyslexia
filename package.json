{
  "name": "pi-dyslexia",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Personal reading and listening preferences for Pi.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoazzurrini/pi-dyslexia.git"
  },
  "files": [
    "extensions/index.ts",
    "extensions/speech/*.ts",
    "extensions/speech/worker.py",
    "extensions/speech/setup.sh",
    "extensions/speech/requirements.txt",
    "extensions/SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:speech-local": "python3 test/speech-worker.py && PI_DYSLEXIA_AUDIO_TEST=1 node --experimental-strip-types --test test/speech-local.test.mjs",
    "setup:speech": "sh extensions/speech/setup.sh",
    "preversion": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/speech/index.ts"
    ],
    "skills": []
  },
  "dependencies": {
    "entities": "7.0.1",
    "marked": "17.0.1"
  }
}
