{
  "name": "pi-dyslexia",
  "version": "0.4.0",
  "private": true,
  "description": "Personal reading and listening preferences for Pi.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoazzurrini/pi-dyslexia.git"
  },
  "files": [
    "extensions/index.ts",
    "extensions/speech/*.ts",
    "extensions/speech/native/Package.swift",
    "extensions/speech/native/Package.resolved",
    "extensions/speech/native/Sources/",
    "extensions/speech/native/Tests/",
    "extensions/speech/native/assets.ts",
    "extensions/speech/native/setup.sh",
    "extensions/speech/native/README.md",
    "extensions/SKILL.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "hooks:install": "lefthook install",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:speech-local": "npm run test:speech-native && PI_DYSLEXIA_AUDIO_TEST=1 node --experimental-strip-types --test test/speech-local.test.ts",
    "setup:speech": "sh extensions/speech/native/setup.sh",
    "test:speech-native": "swift run --package-path extensions/speech/native --jobs 4 --disable-automatic-resolution speech-core-tests",
    "preversion": "npm test"
  },
  "dependencies": {
    "entities": "7.0.1",
    "marked": "17.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "ultracite": "7.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/speech/index.ts"
    ],
    "skills": []
  }
}
